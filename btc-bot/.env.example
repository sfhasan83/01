# Copy this file to ".env" and fill in your values.
# Never share your .env file or commit it to GitHub.

# CoinMarketCap API key (free "Basic" plan is enough): https://coinmarketcap.com/api/
CMC_API_KEY=

# Coins to predict, separated by commas (pairs as named on Binance, MEXC and TradingView)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Which exchange to train the model on: binance or mexc (the other one is used as a fallback)
PRIMARY_EXCHANGE=binance

# How many past candles to learn from for each timeframe (more = slower but steadier)
HISTORY_CANDLES=3000

# Only call UP or DOWN when the model is at least this sure (0.50 - 0.70). Otherwise NEUTRAL.
# On pure random data about 1 in 10 candles still crosses 0.58, so do not set it lower than that.
CONFIDENCE_THRESHOLD=0.58

# Seconds between refreshes in watch mode and in the window
REFRESH_SECONDS=60

# Port for the TradingView webhook receiver (python -m btc_bot webhook)
WEBHOOK_PORT=8080
# A secret word your TradingView alert message must contain, so strangers can't post fake alerts
WEBHOOK_SECRET=change-me

# Trading fee per side used in the backtest, as a fraction (0.001 = 0.1%)
FEE_RATE=0.001
