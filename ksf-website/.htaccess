# KSF Foods static site

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# One address for Google: https://ksffood.com (no www, always HTTPS)
RewriteCond %{HTTP_HOST} ^www\.ksffood\.com$ [NC]
RewriteRule ^ https://ksffood.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old website addresses -> new pages (permanent redirects)
RewriteRule ^(about|about-us|our-story)/?$ /about.html [L,R=301,NC]
RewriteRule ^(offers|offer|shop|products|product|flavours|flavors|menu)/?$ /products.html [L,R=301,NC]
RewriteRule ^(contact|contact-us)/?$ /contact.html [L,R=301,NC]
RewriteRule ^(distributor|distributors|become-a-distributor|wholesale)/?$ /distributors.html [L,R=301,NC]
RewriteRule ^urdu/?$ /ur/ [L,R=301,NC]
RewriteRule ^(home|index\.php)/?$ / [L,R=301,NC]
# /index.html is the same page as / : keep one address
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# Browser caching
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType application/x-javascript "access plus 7 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
</IfModule>

# Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/x-javascript
</IfModule>
