# PSX Signal Bot settings. Copy to .env (setup.bat does this) and edit with Notepad.
# No API key is needed: prices come free from the PSX data portal (dps.psx.com.pk).

# Years of daily history to download and learn from
YEARS=5

# Leave empty to follow EVERY listed stock. Or list a few, e.g. SYMBOLS=OGDC,LUCK,HUBC,ENGRO
SYMBOLS=

# Include Growth Enterprise Market (GEM) companies and ETFs (bonds and sukuk are always left out)
INCLUDE_GEM=1
INCLUDE_ETFS=0

# Stocks trading less than this many rupees a day (20-day average) are marked illiquid
MIN_TURNOVER=2000000

# How sure the model must be before it says BUY or SELL instead of HOLD (0.5 to 0.95)
CONFIDENCE_THRESHOLD=0.55

# Trading costs per side (commission, CVT and fees), used by the backtest. 0.0025 = 0.25 percent
FEE_RATE=0.0025

# Take-profit and stop-loss distances, in multiples of the stock's typical daily range (ATR),
# widened for longer horizons (times the square root of the number of sessions)
TP_ATR_MULT=1.5
SL_ATR_MULT=1.0

# Use Yahoo Finance for a stock when PSX fails for it
USE_YAHOO_FALLBACK=1

# Update data and signals automatically when the window opens
AUTO_UPDATE=1

# Download speed: parallel workers and requests per second (be gentle with the PSX site)
WORKERS=4
REQUESTS_PER_SECOND=2
